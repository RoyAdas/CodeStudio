{
  "name": "code-studio-local",
  "version": "0.5.0",
  "description": "A local AI programming learning workbench for Windows",
  "license": "MIT",
  "author": "RoyAdas",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoyAdas/CodeStudio.git"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node tests/run-browser-tests.mjs",
    "test:package": "node tests/package-smoke.mjs",
    "package:win": "node scripts/package-windows.mjs",
    "prepare:languages": "node scripts/prepare-languages.mjs",
    "prepare:debugger": "node scripts/prepare-debugger.mjs",
    "prepare:python": "node scripts/prepare-python.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.31.0",
    "monaco-editor": "0.57.0",
    "node-pty": "1.1.0",
    "prettier": "3.9.10",
    "pyright": "1.1.414",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.0.2",
    "playwright": "^1.56.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "overrides": {
    "dompurify": "3.4.16"
  }
}
