{
  "name": "code-studio-local",
  "version": "0.2.0",
  "description": "A local AI programming learning workbench for Windows",
  "license": "MIT",
  "author": "RoyAdas",
  "repository": {
    "type": "git",
    "url": "https://github.com/RoyAdas/CodeStudio.git"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server.mjs",
    "typecheck": "tsc --noEmit",
