    "test:package": "node tests/package-smoke.mjs",
    "package:win": "node scripts/package-windows.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "monaco-editor": "0.57.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "playwright": "^1.56.0"
  }
}
